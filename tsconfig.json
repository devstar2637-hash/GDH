{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "shared/**/*.ts",
    "engine/**/*.ts",
    "loop/**/*.ts",
    "data/**/*.ts",
    "web/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "web/client"
  ]
}
